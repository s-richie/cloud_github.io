<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Aaron David B. Abad - IT Student CV">
  <title>Aaron David B. Abad | CV</title>

  <style>
    :root {
      --text: #222;
      --muted: #555;
      --line: #777;
      --paper: #fff;
      --background: #f2f2f2;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 40px 20px;
      background: var(--background);
      color: var(--text);
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.45;
    }

    .cv {
      width: min(100%, 850px);
      margin: 0 auto;
      padding: 56px 64px;
      background: var(--paper);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    header {
      text-align: center;
      margin-bottom: 22px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 5vw, 2.65rem);
      line-height: 1.1;
      font-weight: 700;
    }

    .contact {
      margin: 0;
      color: var(--muted);
      font-size: 0.98rem;
    }

    .contact a {
      color: inherit;
      text-decoration: none;
    }

    .contact a:hover {
      text-decoration: underline;
    }

    section {
      margin-top: 20px;
    }

    h2 {
      margin: 0 0 13px;
      padding-bottom: 7px;
      border-bottom: 1px solid var(--line);
      font-size: 1.08rem;
      letter-spacing: 0.02em;
      font-weight: 700;
    }

    p {
      margin: 0;
      font-size: 0.96rem;
      text-align: justify;
    }

    .education-entry {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
    }

    .education-left strong {
      display: block;
      font-size: 1rem;
    }

    .education-left span {
      font-size: 0.9rem;
    }

    .education-right {
      text-align: right;
      white-space: nowrap;
      font-size: 0.9rem;
    }

    ul {
      margin: 0;
      padding-left: 27px;
    }

    li {
      margin: 3px 0;
      font-size: 0.94rem;
    }

    .project {
      margin-bottom: 8px;
    }

    .project-title {
      margin: 0 0 1px;
      font-weight: 700;
      font-size: 0.98rem;
    }

    .project ul {
      margin-top: 0;
    }

    @media (max-width: 650px) {
      body {
        padding: 0;
        background: var(--paper);
      }

      .cv {
        width: 100%;
        padding: 34px 25px;
        box-shadow: none;
      }

      .education-entry {
        flex-direction: column;
        gap: 2px;
      }

      .education-right {
        text-align: left;
      }

      p {
        text-align: left;
      }
    }

    @media print {
      @page {
        size: A4;
        margin: 0;
      }

      body {
        padding: 0;
        background: white;
      }

      .cv {
        width: 100%;
        min-height: 100vh;
        padding: 45px 55px;
        box-shadow: none;
      }

      a {
        color: inherit !important;
        text-decoration: none !important;
      }
    }
  </style>
</head>

<body>
