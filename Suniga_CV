  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #f5f7fa;
      --card: #ffffff;
      --text: #17202a;
      --muted: #5f6b76;
      --accent: #151515;
      --line: #e4e8ec;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .container {
      width: min(1050px, 92%);
      margin: 0 auto;
    }

    /* HEADER */
    header {
      background: var(--card);
      border-bottom: 1px solid var(--line);
      padding: 55px 0 35px;
    }

    .hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 35px;
    }

    .name {
      font-size: clamp(2rem, 5vw, 3.4rem);
      line-height: 1.05;
      letter-spacing: -1.5px;
      font-weight: 800;
    }

    .role {
      margin-top: 12px;
      color: var(--muted);
      font-size: 1.05rem;
      font-weight: 600;
    }

    .contact {
      text-align: right;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.8;
    }

    /* MAIN */
    main {
      padding: 35px 0 60px;
    }

    section {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 28px;
      margin-bottom: 22px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.035);
    }

    .section-title {
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 1.7px;
      margin-bottom: 18px;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--accent);
      display: inline-block;
    }

    .summary {
      color: #303a43;
      max-width: 900px;
    }

    /* SKILLS */
    .skills {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 28px;
    }

    .skill strong {
      display: block;
      margin-bottom: 3px;
    }

    .skill span {
      color: var(--muted);
    }

    /* TIMELINE */
    .timeline-item {
      position: relative;
      padding-left: 20px;
      border-left: 2px solid #d7dce1;
      margin-bottom: 24px;
    }

    .timeline-item:last-child {
      margin-bottom: 0;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      width: 9px;
      height: 9px;
      background: var(--accent);
      border-radius: 50%;
      left: -5.5px;
      top: 7px;
    }

    .item-title {
      font-size: 1.08rem;
      font-weight: 750;
    }

    .meta {
      color: var(--muted);
      font-size: 0.9rem;
      margin: 2px 0 8px;
    }

    ul {
      padding-left: 19px;
      color: #36414b;
    }

    /* PROJECTS */
    .projects {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .project {
      border: 1px solid var(--line);
      border-radius: 11px;
      padding: 18px;
      background: #fafbfc;
    }

    .project h3 {
      margin-bottom: 3px;
    }

    .project .meta {
      margin-bottom: 7px;
    }

    /* TWO COLUMNS */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    /* FOOTER */
    footer {
      text-align: center;
      color: var(--muted);
      padding: 5px 0 35px;
      font-size: 0.85rem;
    }

    /* RESPONSIVE */
    @media (max-width: 720px) {
      header {
        padding-top: 35px;
      }

      .hero,
      .two-col {
        display: block;
      }

      .contact {
        text-align: left;
        margin-top: 20px;
      }

      .skills,
      .projects {
        grid-template-columns: 1fr;
      }

      section {
        padding: 22px;
      }
    }

    /* PRINT */
    @media print {
      body {
        background: white;
      }

      header {
        padding-top: 25px;
      }

      section {
        box-shadow: none;
        break-inside: avoid;
      }

      main {
        padding-top: 20px;
      }

      footer {
        display: none;
      }
    }
